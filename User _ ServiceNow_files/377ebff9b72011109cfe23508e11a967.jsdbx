window.uxf.scriptLoader.registerInlineScript('2.0.0', '377ebff9b72011109cfe23508e11a967', 'submit_button_p_disabled', '/**\n * @param {params} params\n * @param {api} params.api\n * @param {TransformApiHelpers} params.helpers\n */\nfunction evaluateProperty({\n    api,\n    helpers\n}) {\n    if (api.state.feedbackMessage && api.state.feedbackMessage.length > 1500)\n        return true;\n\n    return !(api.state.feedbackMessage || api.state.starRatings);\n}', '1c6fc15143335110b643a7ec6bb8f234');
window.uxf.scriptLoader.registerInlineScript('1.0.0', '377ebff9b72011109cfe23508e11a967', 'submit_button_c_e_2', '/**\n* @param {params} params\n* @param {api} params.api\n* @param {any} params.event\n*/\nfunction evaluateEvent({api, event}) {\n\tvar payload = {\n\t\tpage: \'admin-home\',\n\t\tuser: api.context.session.user.fullName || api.context.session.user.firstName,\n\t};\n\treturn {\n\t\tevent: \'Share a suggestion form button\',\n\t\tvalue: payload\n\t};\n}', '');
window.uxf.scriptLoader.registerInlineScript('2.0.0', '377ebff9b72011109cfe23508e11a967', 'stylized_text_4_p_text', '/**\n * @param {params} params\n * @param {api} params.api\n * @param {TransformApiHelpers} params.helpers\n */\nfunction script({ api, helpers }) {\n    const { firstName, lastName, language } = api.context.session.user || {};\n     \n     // Default to a generic greeting if first name or last name is missing\n    if (!firstName || !lastName ) {\n        return helpers.translateSync(\'Welcome to Admin Home!\');\n    } \n\n       // Use last name for chinese & japnese else firstname for any other.\n       const name = [\'ja\', \'ja-jp\', \'zh\', \'zh-cn\', \'zh-hk\'].includes(language) ? lastName : firstName;\n      return helpers.translateSync(\'Welcome to Admin Home, {0}!\', name);\n\n \n    \n}', 'c62ec32043b35510b643a7ec6bb8f25d');
window.uxf.scriptLoader.registerInlineScript('2.0.0', '377ebff9b72011109cfe23508e11a967', 'stylized_text_11_p_text', '() => undefined', '3bf134bdfff82210a430ffffffffff13');
window.uxf.scriptLoader.registerInlineScript('1.0.0', '377ebff9b72011109cfe23508e11a967', 'admin_dashboard_c_e_1', '/**\n * @param {params} params\n * @param {api} params.api\n * @param {any} params.event\n */\nfunction evaluateEvent({\n    api,\n    event\n}) {\n    var datasourceType = event.payload.params.dataSourceType;\n\tvar indicatorId = event.payload.params.indicatorSysid;\n    if (datasourceType === \'indicator\') {\n        if (indicatorId === "9f48d534771131101b803a91fa5a9901") {\n            return {\n                route: null,\n                fields: null,\n                params: null,\n                redirect: null,\n                passiveNavigation: null,\n                title: null,\n                multiInstField: null,\n                targetRoute: null,\n                external: {\n                    url: "now/security-center/critical_updates_home",\n                    target: "_blank"\n\n                },\n                navigationOptions: null\n            };\n        } else {\n            return {\n                route: \'ac_kpi_details\',\n                fields: {\n                    \'uuid\': indicatorId\n                },\n                params: null,\n                redirect: null,\n                passiveNavigation: null,\n                title: null,\n                multiInstField: null,\n                targetRoute: null,\n                external: null,\n                navigationOptions: null\n            };\n        }\n    } else if (datasourceType === \'table\') {\n        return {\n            route: \'simplelist\',\n            fields: {\n                \'table\': event.payload.params.table\n            },\n            params: {\n                \'listTitle\': event.payload.params.listTitle,\n                \'query\': event.payload.params.query,\n            },\n            redirect: null,\n            passiveNavigation: null,\n            title: null,\n            multiInstField: null,\n            targetRoute: null,\n            external: null,\n            navigationOptions: null\n        };\n    }\n}\n', '');
