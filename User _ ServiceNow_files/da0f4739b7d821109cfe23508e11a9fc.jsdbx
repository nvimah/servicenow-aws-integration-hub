window.uxf.scriptLoader.registerInlineScript('2.0.0', 'da0f4739b7d821109cfe23508e11a9fc', 'rich_text_2_p_html', '/**\n * @param {params} params\n * @param {api} params.api\n * @param {TransformApiHelpers} params.helpers\n */\nfunction evaluateProperty({\n    api,\n    helpers\n}) {\n    let currentVersionLabel = helpers.translateSync(\'Current version\');\n    let scheduledVersionLabel = helpers.translateSync(\'Scheduled version\');\n    let scheduledVersion = api.state.scheduledVersion === \'N/A\' ? helpers.translateSync(\'Latest version\') : api.state.scheduledVersion;\n    let scheduledOn = api.state.scheduledOn === \'N/A\' ? \'\' : helpers.translateSync(\'Scheduled on {0}\', new Date(api.state.scheduledOn).toDateString());\n    let eolVal = api.state.eolVal === \'Yes\' ? helpers.translateSync(\'End of Life\') : \'\';\n    let html = `\n    <style>\n    .version-label {\n      font-family: var(--now-font-family, \'Lato\');\n      font-style: normal;\n      font-weight: 400;\n      font-size: var(--now-global-font-size--md, 16px);\n      color: rgb(var(--now-color_text--primary, 21, 25, 32));\n      padding-bottom: 0.8rem\n    }\n    .version-value {\n      font-family: var(--now-font-family, \'Lato\');\n      font-style: normal;\n      font-weight: 300;\n      font-size: var(--now-global-font-size--xl, 24px);\n      color: rgb(var(--now-color_text--primary, 21, 25, 32));\n      padding-bottom: 0.8rem\n    }\n    .grid-container {\n      display: grid;\n      grid-template-columns: auto auto;\n      column-gap: 2rem;\n    }\n</style>\n  </style>\n  <div class=\'grid-container\'>\n    <div class=\'version-label\'>${currentVersionLabel}</div>\n    <div class=\'version-label\'>${scheduledVersion}</div>\n    <div class=\'version-value\'>${helpers.translateSync(api.state.currentReleaseVersion)}</div>\n    <div class=\'version-value\'>${scheduledVersion}</div>\n    <div class=\'version-label\'>${eolVal}</div>\n    <div class=\'version-label\'>${scheduledOn}</div>\n  </div>\n  `;\n    return html;\n}', 'bb41dbb9b7d821109cfe23508e11a994');
window.uxf.scriptLoader.registerInlineScript('2.0.0', 'da0f4739b7d821109cfe23508e11a9fc', 'rich_text_6_p_html', '/**\n * @param {params} params\n * @param {api} params.api\n * @param {TransformApiHelpers} params.helpers\n */\nfunction evaluateProperty({ api, helpers }) {\n    // Translating each sentence using translateSync\n    let upgradedText = helpers.translateSync(\'You upgraded your instance around this same time last year.\');\n    let upgradePrompt = helpers.translateSync(\'Want to upgrade now? Your new upgrade agent tools have prepared your upgrade for you. Review now and schedule your upgrade.\');\n    let cloneText = helpers.translateSync(\'Clone has set your cloning time and profile.\');\n    let testingText = helpers.translateSync(\'Testing agent has begun generating tests.\');\n    let conflictText = helpers.translateSync(\'Upgrade conflict agent has recommendations to review.\');\n\n    let html = `\n    <style>\n    .text-block {\n      font-family: var(--now-font-family, \'Lato\');\n      font-style: normal;\n      font-weight: 400;\n      font-size: var(--now-global-font-size--md, 16px);\n      color: rgb(var(--now-color_text--primary, 21, 25, 32));\n      \n    }\n    .grid-container {\n      display: grid;\n      grid-template-columns: auto;\n    }\n    ul {\n      margin: 0;\n      padding-left: 1.5rem;\n    }\n    li {\n      font-family: var(--now-font-family, \'Lato\');\n      font-size: var(--now-global-font-size--md, 16px);\n      color: rgb(var(--now-color_text--primary, 21, 25, 32));\n      \n    }\n    </style>\n\n    <div class=\'grid-container\'>\n      <div class=\'text-block\'>\n        ${upgradedText}\n        ${upgradePrompt}\n      </div>\n      <ul>\n        <li>${cloneText}</li>\n        <li>${testingText}</li>\n        <li>${conflictText}</li>\n      </ul>\n    </div>\n  `;\n  \n    return html;\n}', '721bb73b83a312108aabe5e5422bc08e');
window.uxf.scriptLoader.registerInlineScript('1.0.0', 'da0f4739b7d821109cfe23508e11a9fc', 'text_link_5_c_e_0', '/**\n* @param {params} params\n* @param {api} params.api\n* @param {any} params.event\n*/\nfunction evaluateEvent({api, event}) {\n\tvar payload = {\n\t\tpage: \'admin-home\',\n\t\tuser: api.context.session.user.fullName || api.context.session.user.firstName,\n\t};\n\treturn {\n\t\tevent: \'Upgrade Console\',\n\t\tvalue: payload\n\t};\n}', '');
window.uxf.scriptLoader.registerInlineScript('1.0.0', 'da0f4739b7d821109cfe23508e11a9fc', 'text_link_4_c_e_0', '/**\n* @param {params} params\n* @param {api} params.api\n* @param {any} params.event\n*/\nfunction evaluateEvent({api, event}) {\n\tvar payload = {\n\t\tpage: \'admin-home\',\n\t\tuser: api.context.session.user.fullName || api.context.session.user.firstName,\n\t};\n\treturn {\n\t\tevent: \'View all adoption blueprints link\',\n\t\tvalue: payload\n\t};\n}', '');
window.uxf.scriptLoader.registerInlineScript('2.0.0', 'da0f4739b7d821109cfe23508e11a9fc', 'rich_text_3_p_html', '/**\n * @param {params} params\n * @param {api} params.api\n * @param {TransformApiHelpers} params.helpers\n */\nfunction evaluateProperty({\n    api,\n    helpers\n}) {\n    let installedLabel = helpers.translateSync(\'Installed\');\n    let totalLabel = helpers.translateSync(\'Total\');\n    let appsInstalledVal = api.state.appsInstalled;\n    let totalAppsVal = api.state.totalApps;\n     let applicationsMsg = helpers.translateSync(\'Applications\');\n    let installedMessageLabel = `${appsInstalledVal}&#20;${installedLabel}&#20;${applicationsMsg}`;\n    let totalMessageLabel = `${totalAppsVal}&#20;${totalLabel}&#20;${applicationsMsg}`;\n    let html = `\n    <style>\n    .version-label {\n      font-family: var(--now-font-family, \'Lato\');\n      font-style: normal;\n      font-weight: 400;\n      font-size: var(--now-global-font-size--md, 16px);\n      color: rgb(var(--now-color_text--primary, 21, 25, 32));\n      padding-bottom: 0.8rem\n    }\n    .version-value {\n      font-family: var(--now-font-family, \'Lato\');\n      font-style: normal;\n      font-weight: 300;\n      font-size: var(--now-global-font-size--xl, 24px);\n      color: rgb(var(--now-color_text--primary, 21, 25, 32));\n      padding-bottom: 0.8rem\n    }\n    .grid-container {\n      display: grid;\n      grid-template-columns: auto auto;\n    }\n    a {\n      text-decoration: none;\n      color: rgb(var(--now-color_text--primary));\n    }\n    a:hover {\n      background-color: rgb(var(--now-color_background--secondary));\n    }\n</style>\n  </style>\n  <div class=\'grid-container\'>\n    <div class=\'version-label\'>${installedLabel}</div>\n    <div class=\'version-label\'>${totalLabel}</div>\n    <div class=\'version-value\'><a href=\'/now/app-manager/home/tab/installed/sort/recently_released/filter/applications\' target=\'_blank\' aria-label=${installedMessageLabel}>${appsInstalledVal}</a></div>\n    <div class=\'version-value\'><a href=\'/now/app-manager/home/tab/available_for_you/sort/recently_released/filter/applications\' target=\'_blank\' aria-label=${totalMessageLabel}>${totalAppsVal}</a></div>\n  </div>\n  `;\n    return html;\n}', '1ab29ff9b7d821109cfe23508e11a97a');
window.uxf.scriptLoader.registerInlineScript('2.0.0', 'da0f4739b7d821109cfe23508e11a9fc', 'rich_text_5_p_html', '/**\n * @param {params} params\n * @param {api} params.api\n * @param {TransformApiHelpers} params.helpers\n */\nfunction evaluateProperty({\n    api,\n    helpers\n}) {\n    let label = helpers.translateSync(\'Needs update\');\n    let html = `\n    <style>\n    .version-label {\n      font-family: var(--now-font-family, \'Lato\');\n      font-style: normal;\n      font-weight: 400;\n      font-size: var(--now-global-font-size--md, 16px);\n      color: rgb(var(--now-color_text--primary, 21, 25, 32));\n      padding-bottom: 0.8rem\n    }\n    .grid-container {\n      display: grid;\n      grid-template-columns: auto auto;\n    }\n    a {\n      text-decoration: none;\n      color: rgb(var(--now-color_text--primary));\n    }\n    a:hover {\n      background-color: rgb(var(--now-color_background--secondary));\n    }\n</style>\n  </style>\n  <div class=\'grid-container\'>\n    <div class=\'version-label\' aria-label=Needs&#20Update>${label}</div>\n  </div>\n  `;\n    return html;\n}', '808382b9430102101daba8b95ab8f272');
window.uxf.scriptLoader.registerInlineScript('2.0.0', 'da0f4739b7d821109cfe23508e11a9fc', 'single_score_2_p_dataPassthrough', '/**\n * @param {params} params\n * @param {api} params.api\n * @param {TransformApiHelpers} params.helpers\n */\nfunction evaluateProperty({\n    api,\n    helpers\n}) {\n    return [{\n        "data": [{\n            "value": api.state.appsNeedUpdate,\n            "change": "0",\n            "changePercent": "0"\n        }],\n        "metadata": {\n            "dataSourceLabel": "",\n            "eventData": {\n                "table": ""\n            },\n            "groupBy": [{\n                "series": [],\n                "elements": [],\n                "id": "assignment_group",\n                "fieldType": "reference",\n                "label": "Assignment group"\n            }],\n            "format": {\n                "unitFormat": "{0}"\n            },\n            "aggregateBy": 4,\n            "metricId": ""\n        }\n    }];\n}', '44e11b79b7d821109cfe23508e11a991');
window.uxf.scriptLoader.registerInlineScript('1.0.0', 'da0f4739b7d821109cfe23508e11a9fc', 'text_link_2_c_e_0', '/**\n* @param {params} params\n* @param {api} params.api\n* @param {any} params.event\n*/\nfunction evaluateEvent({api, event}) {\n\tvar payload = {\n\t\tpage: \'admin-home\',\n\t\tuser: api.context.session.user.fullName || api.context.session.user.firstName,\n\t};\n\treturn {\n\t\tevent: \'View all applications link\',\n\t\tvalue: payload\n\t};\n}', '');
window.uxf.scriptLoader.registerClientScript('2.0.0', '01e946485b2021107b9651d11581c7cc', [], '/**\n * @param {params} params\n * @param {api} params.api\n * @param {any} params.event\n * @param {any} params.imports\n * @param {ApiHelpers} params.helpers\n */\nfunction handler({\n    api,\n    event,\n    helpers,\n    imports\n}) {\n    helpers.timing.setTimeout(async () => {\n        try {\n            const resource = await helpers.snHttp(\'/api/sn_admin_center/adminx/landing_page_instance_upgrade_data\', {\n                method: \'GET\',\n                batch: false\n            });\n            const {\n                currentReleaseVersion,\n                endOfLife,\n                scheduledVersion,\n                scheduledOn\n            } = resource.response.result;\n            api.setState(\'currentReleaseVersion\', currentReleaseVersion);\n            api.setState(\'endOfLife\', endOfLife);\n            api.setState(\'scheduledVersion\', scheduledVersion);\n            api.setState(\'scheduledOn\', scheduledOn);\n            api.setState(\'isInstanceUpgradeAPIProcessed\', true);\n        } catch ({\n            error\n        }) {\n            console.error(error);\n        }\n    }, 3000);\n}');

window.uxf.scriptLoader.registerClientScript('2.0.0', '40063b3383a312108aabe5e5422bc00c', [], '/**\n* @param {params} params\n* @param {api} params.api\n* @param {any} params.event\n* @param {any} params.imports\n* @param {ApiHelpers} params.helpers\n*/\nfunction handler({api, event, helpers, imports}) {\n    api.emit(\'NAV_ITEM_SELECTED\', {\n        external: {\n            url: \'now/upgrade-management\'\n        }\n    });\n}');

window.uxf.scriptLoader.registerClientScript('2.0.0', '7676d731b71c21109cfe23508e11a912', [], '/**\n * @param {params} params\n * @param {api} params.api\n * @param {any} params.event\n * @param {any} params.imports\n * @param {ApiHelpers} params.helpers\n */\nasync function handler({\n    api,\n    event,\n    helpers,\n    imports\n}) {\n\n    // Not to call app Client API incase hide entitled widget propert is set as true\n    let shouldNotCallAppClient = false;\n    try {\n        const resource = await helpers.snHttp(\'/api/sn_admin_center/adminx/getHideEntitledWidgetFlag\', {\n            method: \'GET\',\n            batch: false\n        });\n        const {\n            shouldHideWidget,\n        } = resource.response.result;\n        api.setState(\'hideEntitledWidget\', shouldHideWidget);\n        shouldNotCallAppClient = shouldHideWidget === \'true\';\n    } catch ({\n        error\n    }) {\n        console.error(error);\n    }\n\n    if (shouldNotCallAppClient)\n        return;\n\n    helpers.timing.setTimeout(async () => {\n        try {\n            const appsInstalledResource = await helpers.snHttp(\'/api/sn_appclient/appmanager/apps?tab_context=installed\', {\n                method: \'POST\',\n                batch: false\n            });\n            let appsInstalledResult = appsInstalledResource.response.result;\n            let appsInstalled = appsInstalledResult.apps && appsInstalledResult.apps.length > 0 ? appsInstalledResult.apps.length : 0;\n\n            const appsUpdateResource = await helpers.snHttp(\'/api/sn_appclient/appmanager/apps?tab_context=updates\', {\n                method: \'POST\',\n                batch: false\n            });\n            let appsUpdateResult = appsUpdateResource.response.result;\n            let appsNeedUpdate = appsUpdateResult.apps && appsUpdateResult.apps.length > 0 ? appsUpdateResult.apps.length : 0;\n\n            const appsAvailableResource = await helpers.snHttp(\'/api/sn_appclient/appmanager/apps?tab_context=available_for_you\', {\n                method: \'POST\',\n                batch: false\n            });\n\n            let appsAvailableResult = appsAvailableResource.response.result;\n            let totalApps = appsAvailableResult.apps && appsAvailableResult.apps.length > 0 ? appsAvailableResult.apps.length : 0;\n\n            api.setState(\'appsInstalled\', appsInstalled + \'\');\n            api.setState(\'appsNeedUpdate\', appsNeedUpdate + \'\');\n            api.setState(\'totalApps\', totalApps + \'\');\n        } catch ({\n            error\n        }) {\n            console.error(error);\n        }\n    }, 1000);\n\n}');

window.uxf.scriptLoader.registerClientScript('2.0.0', '8d32d3f9b7d821109cfe23508e11a953', [], '/**\n* @param {params} params\n* @param {api} params.api\n* @param {any} params.event\n* @param {any} params.imports\n* @param {ApiHelpers} params.helpers\n*/\nfunction handler({api, event, helpers, imports}) {\n    api.emit(\'NAV_ITEM_SELECTED\', {\n        external: {\n            url: \'now/app-manager/home/tab/updates/sort/recently_released/filter/applications\'\n        }\n    });\n}');
}

return pageFragment;

